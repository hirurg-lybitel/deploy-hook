# === Deploy-hook server (this service) ===

# Node environment (optional; production is typical for this service)
NODE_ENV=production

# Port this service listens on (0.0.0.0:PORT)
PORT=3000

# HMAC secret for webhook signature verification (X-Hub-Signature-256). Required.
SECRET=yoursecret

# PM2 Keymetrics keys; passed only to central (naytron) deployments, not to client workspaces.
# Optional — omit or leave empty if you don't use PM2 Enterprise.
IN_PM2_PUBLIC_KEY=
IN_PM2_SECRET_KEY=